# Site paths. Copy to .env (untracked) and fill in; pixi exports them on every `pixi run`.
# One KEY=value per line: absolute paths, no quotes, no $VARS, no comment after a value.
# A variable already set in the shell wins over this file. Commented lines keep their default.

# LeRobot datasets (default: storage/datasets in the repository)
#REKI_DATASETS_ROOT=
# Runs and checkpoints (default: storage/runs in the repository)
#REKI_RUNS_DIR=
# Simulators, one directory per benchmark: scripts/eval/install.sh (default: storage/sim in the repository)
#REKI_SIM_ROOT=
# Hugging Face cache (default: ~/.cache/huggingface) and its datasets cache
#HF_HOME=
#HF_DATASETS_CACHE=
# Slurm settings of the launchers (docs/training.md#slurm)
#SBATCH_PARTITION=
#REKI_EVAL_MEM_PER_GPU=
#REKI_GPUS_PER_NODE=
#REKI_CPUS_PER_GPU=
#REKI_CONTAINER_IMAGE=
#REKI_CONTAINER_MOUNTS=

# RoboTwin expert-seed cache (default: ~/.cache/reki/robotwin_seed_cache)
#REKI_ROBOTWIN_SEED_CACHE=
